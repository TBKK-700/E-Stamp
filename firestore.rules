rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isSuperAdmin() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "superadmin";
    }

    function validActivityPoints(activityId, type, points) {
      return (type == "win" && points == 20)
        || (type == "join" && activityId in ["risk", "kahoot", "bingo"] && points == 5)
        || (type == "join" && activityId == "carbon" && points == 20);
    }

    function validCompletionScoreUpdate(userId) {
      let completionId = request.resource.data.scores.lastCompletionId;
      let completion = getAfter(/databases/$(database)/documents/participants/$(userId)/activityCompletions/$(completionId)).data;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["state", "scores", "updatedAt"])
        && request.resource.data.state.coupons == resource.data.state.coupons
        && completion.userId == userId
        && completion.completionId == completionId
        && validActivityPoints(completion.activityId, completion.type, completion.points)
        && request.resource.data.scores.participationPoints
           == resource.data.scores.participationPoints + (completion.type == "join" ? completion.points : 0)
        && request.resource.data.scores.winnerPoints
           == resource.data.scores.winnerPoints + (completion.type == "win" ? completion.points : 0)
        && request.resource.data.scores.totalPoints
           == request.resource.data.scores.participationPoints + request.resource.data.scores.winnerPoints;
    }

    function isLegacyCompletion(completionId) {
      return completionId == request.resource.data.dateKey + "_" + request.resource.data.activityId + "_" + request.resource.data.type;
    }

    function isKahootRoundCompletion(completionId) {
      return request.auth.uid == request.resource.data.userId
        && request.resource.data.activityId == "kahoot"
        && request.resource.data.type == "join"
        && request.resource.data.points == 5
        && request.resource.data.source == "quiz-room-qr"
        && request.resource.data.roomCode is string
        && request.resource.data.roomCode.matches("^[0-9]{6}$")
        && completionId == request.resource.data.dateKey + "_kahoot_join_" + request.resource.data.roomCode;
    }

    function isRiskRoundCompletion(userId, completionId) {
      return isAdmin()
        && request.resource.data.activityId == "risk"
        && request.resource.data.type in ["join", "win"]
        && request.resource.data.source == "admin-game"
        && request.resource.data.roundId is string
        && request.resource.data.roundId.matches("^[0-9a-f]{32}$")
        && completionId == request.resource.data.dateKey + "_risk_" + request.resource.data.type + "_" + request.resource.data.roundId
        && (
          request.resource.data.type == "join"
          || exists(/databases/$(database)/documents/participants/$(userId)/activityCompletions/$(request.resource.data.dateKey + "_risk_join_" + request.resource.data.roundId))
        );
    }

    match /participants/{userId} {
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && request.resource.data.state.coupons.size() == 0;
      allow read: if signedIn()
                  && (request.auth.uid == userId || isAdmin());
      allow update: if signedIn()
                    && (
                      isAdmin()
                      || (
                        request.auth.uid == userId
                        && (
                          (
                            request.resource.data.scores == resource.data.scores
                            && request.resource.data.state.coupons == resource.data.state.coupons
                          )
                          || (
                            request.resource.data.scores == resource.data.scores
                            &&
                            request.resource.data.state.coupons.size() == resource.data.state.coupons.size() + 1
                            && request.resource.data.state.coupons[request.resource.data.state.coupons.size() - 1].used == false
                            && getAfter(/databases/$(database)/documents/system/couponInventory).data.lastIssuedTo == request.auth.uid
                            && getAfter(/databases/$(database)/documents/system/couponInventory).data.lastCouponCode
                               == request.resource.data.state.coupons[request.resource.data.state.coupons.size() - 1].code
                          )
                          || validCompletionScoreUpdate(userId)
                        )
                      )
                    );
      allow delete: if isSuperAdmin();
    }

    match /participants/{userId}/activityCompletions/{completionId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
                    && (request.auth.uid == userId || isAdmin())
                    && request.resource.data.userId == userId
                    && request.resource.data.completionId == completionId
                    && (
                      isLegacyCompletion(completionId)
                      || isKahootRoundCompletion(completionId)
                      || isRiskRoundCompletion(userId, completionId)
                    )
                    && request.resource.data.dateKey.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
                    && validActivityPoints(request.resource.data.activityId, request.resource.data.type, request.resource.data.points)
                    && request.resource.data.completedAt == request.time
                    && getAfter(/databases/$(database)/documents/participants/$(userId)).data.scores.lastCompletionId == completionId;
      allow update, delete: if false;
    }

    match /admins/{adminId} {
      allow read: if signedIn()
                  && (request.auth.uid == adminId || isSuperAdmin());
      allow create, update, delete: if isSuperAdmin();
    }

    match /qrTokens/{tokenId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.active == true
                    && request.resource.data.action in [
                      "join:risk", "win:risk",
                      "join:kahoot", "win:kahoot",
                      "join:bingo", "win:bingo",
                      "join:carbon"
                    ]
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.expiresAt > request.time
                    && request.resource.data.expiresAt <= request.time + duration.value(90, "s");
      allow update, delete: if isAdmin();
    }

    match /system/grandPrizeCounter {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.nextNumber == 2
                    && request.resource.data.lastIssuedNumber == 1
                    && request.resource.data.lastIssuedCode == "SHE26-0001"
                    && request.resource.data.lastIssuedTo == request.auth.uid
                    && getAfter(/databases/$(database)/documents/participants/$(request.auth.uid)).data.state.grandCode == "SHE26-0001";
      allow update: if signedIn()
                    && request.resource.data.nextNumber == resource.data.nextNumber + 1
                    && request.resource.data.lastIssuedNumber == resource.data.nextNumber
                    && request.resource.data.lastIssuedTo == request.auth.uid
                    && request.resource.data.lastIssuedCode is string
                    && getAfter(/databases/$(database)/documents/participants/$(request.auth.uid)).data.state.grandCode == request.resource.data.lastIssuedCode;
      allow delete: if isSuperAdmin();
    }

    match /system/couponInventory {
      allow read: if signedIn();
      allow create: if (
                      isAdmin()
                      && request.resource.data.inventoryInitialized == true
                      && request.resource.data.foodRemaining >= 0
                      && request.resource.data.foodRemaining <= 500
                      && request.resource.data.coffeeRemaining >= 0
                      && request.resource.data.coffeeRemaining <= 50
                      && request.resource.data.nextCouponNumber >= 1
                    )
                    || (
                      signedIn()
                      && request.resource.data.nextCouponNumber == 2
                      && request.resource.data.foodRemaining >= 0
                      && request.resource.data.coffeeRemaining >= 0
                      && request.resource.data.foodRemaining + request.resource.data.coffeeRemaining == 549
                      && request.resource.data.lastCouponCode == "CP-0001"
                      && request.resource.data.lastIssuedTo == request.auth.uid
                      && getAfter(/databases/$(database)/documents/participants/$(request.auth.uid)).data.state.coupons.size()
                         == get(/databases/$(database)/documents/participants/$(request.auth.uid)).data.state.coupons.size() + 1
                    );
      allow update: if signedIn()
                    && request.resource.data.nextCouponNumber == resource.data.nextCouponNumber + 1
                    && request.resource.data.foodRemaining >= 0
                    && request.resource.data.coffeeRemaining >= 0
                    && request.resource.data.foodRemaining + request.resource.data.coffeeRemaining
                       == resource.data.foodRemaining + resource.data.coffeeRemaining - 1
                    && (
                      (
                        request.resource.data.lastIssuedTo == request.auth.uid
                        && getAfter(/databases/$(database)/documents/participants/$(request.auth.uid)).data.state.coupons.size()
                           == get(/databases/$(database)/documents/participants/$(request.auth.uid)).data.state.coupons.size() + 1
                      )
                      || (
                        isAdmin()
                        && request.resource.data.lastIssuedTo is string
                        && getAfter(/databases/$(database)/documents/participants/$(request.resource.data.lastIssuedTo)).data.state.coupons.size()
                           == get(/databases/$(database)/documents/participants/$(request.resource.data.lastIssuedTo)).data.state.coupons.size() + 1
                        && getAfter(/databases/$(database)/documents/participants/$(request.resource.data.lastIssuedTo)).data.state.coupons[
                             getAfter(/databases/$(database)/documents/participants/$(request.resource.data.lastIssuedTo)).data.state.coupons.size() - 1
                           ].code == request.resource.data.lastCouponCode
                      )
                    );
      allow delete: if isSuperAdmin();
    }
  }
}
